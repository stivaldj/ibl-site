{
  "name": "variant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site",
    "build:site": "vite build",
    "preview": "vite preview",
    "generate:pages": "python3 generate_pages.py",
    "assets:photos:check": "python3 process_fotos.py --dry-run --sync",
    "assets:photos:sync": "python3 process_fotos.py --sync",
    "assets:nobg:check": "python3 remove_bg_batch.py --dry-run --sync",
    "assets:nobg:sync": "python3 remove_bg_batch.py --sync",
    "scrape:specs": "python3 scrape_specs.py --strict",
    "verify:dist": "node scripts/verify-dist.mjs",
    "rebuild:site": "npm run generate:pages && npm run build:site && npm run verify:dist",
    "launch:gate:smoke": "node scripts/launch-gate-smoke.mjs",
    "launch:gate:lead": "node scripts/launch-gate-lead.mjs",
    "playwright:install": "playwright install chromium",
    "lead:webhook:mock": "node scripts/mock-lead-webhook.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1"
  }
}
