# Google Analytics 4 (obrigatório em produção)
VITE_GA4_ID=

# WhatsApp comercial em E.164 sem "+" (ex: 556733584100)
# Usado por main.js, mobile/main.js e generate_pages.py (mesma env var).
# Fallback no código: telefone da matriz Campo Grande/MS (67) 3358-4100.
# TODO_CONFIRMAR: número WhatsApp Business oficial da IBL.
VITE_WHATSAPP_NUMBER=556733584100

# Webhook de leads para CRM (ibl-ai-os)
# Fase 2 local: `npm run lead:webhook:mock`
# Falha simulada: `npm run lead:webhook:mock -- --mode failure --port 8788`
# Aponte o runtime local para o mock antes de verificar payloads no browser.
# Em produção: usar a URL pública do endpoint de leads do ibl-ai-os quando exposto.
# Se vazio, o site degrada com segurança para o fallback WhatsApp (estado "skipped").
VITE_LEAD_WEBHOOK_URL=http://127.0.0.1:8787/lead

# SLA operacional para alerta de lead sem contato (em horas)
VITE_LEAD_SLA_HOURS=2
