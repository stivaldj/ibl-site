# Google Analytics 4 (opcional)
VITE_GA4_ID=

# Webhook de leads para CRM (opcional)
# Fase 2 local: `npm run lead:webhook:mock`
# Falha simulada: `npm run lead:webhook:mock -- --mode failure --port 8788`
# Aponte o runtime local para o mock antes de verificar payloads no browser.
# Troque pelo endpoint real apenas fora da verificação local.
VITE_LEAD_WEBHOOK_URL=http://127.0.0.1:8787/lead

# SLA operacional para alerta de lead sem contato (em horas)
VITE_LEAD_SLA_HOURS=2
