# IBL Máquinas — configuração Apache/cPanel
# Gerado pelo repositório (public/.htaccess) — entra no dist/ em todo build.

# --- HTTPS + domínio canônico (sem www) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://iblmaquinas.com.br/$1 [L,R=301]

  # Endereços do site antigo (WordPress), indexados pelo Google. Cada um vai
  # para a página equivalente; sem isso viram 404 e o ranking se perde.
  RewriteRule ^home/?$ / [L,R=301]
  RewriteRule ^sobre-nos/?$ /sobre/ [L,R=301]
  RewriteRule ^(servicos|pecas)/?$ /case/#posvenda [L,R=301,NE]
  RewriteRule ^todos-os-produtos/?$ /case/catalogo/ [L,R=301]
  RewriteRule ^(todos-os-produtos|tipo)/escavadeiras/?$ /case/escavadeiras-hidraulicas/ [L,R=301]
  RewriteRule ^(todos-os-produtos|tipo)/(minicarregadeiras|motoniveladoras|pas-carregadeiras|retroescavadeiras|tratores-de-esteiras)/?$ /case/$2/ [L,R=301]
  RewriteRule ^w20g/?$ /case/pas-carregadeiras/w20g/ [L,R=301]
  RewriteRule ^produtos/(845b|865b|885b)/?$ /case/motoniveladoras/$1-series-2/ [L,R=301]
  RewriteRule ^produtos/(cx130c|cx180c|cx220c-s2|cx240c-me|cx350c)/?$ /case/escavadeiras-hidraulicas/$1/ [L,R=301]
  RewriteRule ^produtos/cx370c-me/?$ /case/escavadeiras-hidraulicas/ [L,R=301]
  RewriteRule ^produtos/(sr150b|sr175b|sr200b)/?$ /case/minicarregadeiras/$1/ [L,R=301]
  RewriteRule ^produtos/(621e|721e|821e)/?$ /case/pas-carregadeiras/$1/ [L,R=301]
  RewriteRule ^produtos/w20f/?$ /case/pas-carregadeiras/ [L,R=301]
  RewriteRule ^produtos/580n/?$ /case/retroescavadeiras/580n/ [L,R=301]
  RewriteRule ^produtos/(1150l|1650l|2050m)/?$ /case/tratores-de-esteiras/$1/ [L,R=301]
  RewriteRule ^produtos/?(.*)$ /case/catalogo/ [L,R=301]
  # Páginas-lixo do WordPress: removidas de propósito (410 tira do índice mais rápido que 404)
  RewriteRule ^(20[0-9]{2}/|category/|author/|elementor-hf/) - [G]
</IfModule>

# --- Migração de rotas (v2 multi-marca) ---

# --- Página de erro ---
ErrorDocument 404 /404.html

# --- Compressão ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# --- Cache ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Assets com hash no nome são imutáveis
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Segurança básica ---
Options -Indexes
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  # HSTS: depois da 1ª visita com cadeado, o navegador nunca mais tenta http://.
  # Só é enviado em resposta HTTPS. Sem includeSubDomains: webmail/cpanel ficam de fora.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>
